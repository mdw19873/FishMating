<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.mrsuffix</groupId>
    <artifactId>fishmating</artifactId>
    <version>1.3.0</version>
    <packaging>jar</packaging>

    <name>FishMating</name>
    <description>A Minecraft plugin for fish breeding mechanics</description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Server API. Default targets the lowest supported version (1.21.11) so a
             single jar runs on 1.21.11 and newer (incl. 26.1). The `paper-26` profile
             overrides this to compile-check against the 26.1 API. -->
        <paper.api.version>1.21.11-R0.1-SNAPSHOT</paper.api.version>

        <!-- Test toolchain versions -->
        <junit.version>6.1.0</junit.version>
        <mockbukkit.version>4.110.0</mockbukkit.version>
        <!-- Adventure: paper-api's types implement Adventure interfaces, but as a
             'provided' dependency its transitive Adventure stack is not propagated to
             our compile/test classpath. We import the adventure-bom (matching the
             version paper-api 1.21.11 declares) to align every Adventure artifact —
             including the serializers MockBukkit pulls in — and declare adventure-api
             directly so compilation and MockBukkit can resolve it. -->
        <adventure.version>4.26.1</adventure.version>
        <jacoco.version>0.8.14</jacoco.version>
        <maven-surefire-plugin.version>3.5.5</maven-surefire-plugin.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc-repo</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>spigotmc-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
        <repository>
            <id>sonatype</id>
            <url>https://oss.sonatype.org/content/groups/public/</url>
        </repository>
        <!-- WorldGuard / WorldEdit API (optional integration; provided scope) -->
        <repository>
            <id>enginehub-repo</id>
            <url>https://maven.enginehub.org/repo/</url>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <!-- Aligns all JUnit 6 (Jupiter + Platform) artifacts to one version -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Aligns the whole Adventure stack (paper-api + MockBukkit) -->
            <dependency>
                <groupId>net.kyori</groupId>
                <artifactId>adventure-bom</artifactId>
                <version>${adventure.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.api.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Optional WorldGuard integration: respect the "allow-fish-breeding" region flag.
             provided so it isn't shaded; pulls WorldEdit transitively (for BukkitAdapter).
             Pin by hand — do NOT let Dependabot bump it. -->
        <dependency>
            <groupId>com.sk89q.worldguard</groupId>
            <artifactId>worldguard-bukkit</artifactId>
            <version>7.0.14</version>
            <scope>provided</scope>
        </dependency>

        <!-- Unit testing: JUnit 6 (Jupiter) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Required at runtime by Surefire to launch the JUnit Platform -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Integration testing: in-memory Bukkit server for the 1.21 API -->
        <dependency>
            <groupId>org.mockbukkit.mockbukkit</groupId>
            <artifactId>mockbukkit-v1.21</artifactId>
            <version>${mockbukkit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Needed to compile against paper-api and by MockBukkit at runtime
             (see adventure.version note above) -->
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-api</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <compilerArgs>
                        <arg>-Xlint:deprecation</arg>
                        <arg>-Xlint:unchecked</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <!-- Attach the coverage agent to the test JVM -->
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <!-- Generate HTML/XML/CSV report into target/site/jacoco -->
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>

    <!--
      Compatibility guards. The shipped jar is built against 1.21.11 (default), but the
      plugin declares support for all 1.21.x through 26.1. These profiles compile the
      main sources against the floor and ceiling APIs in CI so any drift (a symbol we
      use being added after 1.21.0, or removed by 26.1) fails the build early. They are
      compile-only checks and do not produce the released artifact.
    -->
    <profiles>
        <!-- Floor: oldest supported API (1.21.0). Runs on Java 21. -->
        <profile>
            <id>paper-floor</id>
            <properties>
                <paper.api.version>1.21-R0.1-SNAPSHOT</paper.api.version>
            </properties>
        </profile>
        <!-- Ceiling: the 26.1 API, which is compiled for Java 25. -->
        <profile>
            <id>paper-26</id>
            <properties>
                <paper.api.version>26.1.2.build.64-stable</paper.api.version>
                <maven.compiler.release>25</maven.compiler.release>
            </properties>
        </profile>
    </profiles>
</project>
